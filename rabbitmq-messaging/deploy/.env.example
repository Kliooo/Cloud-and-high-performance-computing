# Copy to .env and change what you need — the defaults work as they are.
# `docker compose` reads this file automatically.

# Credentials of the demo broker. The broker is published on 127.0.0.1 only, but these
# are still demo values: replace them for anything that outlives the assignment.
RABBITMQ_USER=123
RABBITMQ_PASSWORD=123
RABBITMQ_VHOST=/

# Host-side ports (bound to the loopback interface).
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672

# Topology names. Both services read the same variables, so a rename stays consistent.
EXCHANGE_NAME=calc.exchange
DEAD_LETTER_EXCHANGE=calc.dlx
QUEUE_NAME=calc.jobs
DLQ_NAME=calc.jobs.dlq

# Producer: one job every N seconds; every POISON_EVERY-th job is invalid on purpose
# (0 disables the injection and the dead-letter queue stays empty).
PRODUCER_INTERVAL_SECONDS=2.5
POISON_EVERY=5

# Consumer: how many unacknowledged messages one worker may hold at a time.
PREFETCH_COUNT=10

LOG_LEVEL=INFO

# Image tag used by docker-compose.yml.
DOCKERHUB_USER=local
IMAGE_TAG=1.0.0
