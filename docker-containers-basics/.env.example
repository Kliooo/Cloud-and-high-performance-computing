# Optional: copy this file to .env (cp .env.example .env) to override the defaults below.
# docker compose reads .env automatically, and the whole stack starts without it.

# Docker Hub account used in image names for build and push
DOCKERHUB_USER=your-dockerhub-login

# Database settings (the volume is initialized with these values, so keep them afterwards)
POSTGRES_DB=appdb
POSTGRES_USER=appuser

# Host port of the entry point
API_PORT=8000
