# systemd unit for RETRO RALLY.
# Install:
#   sudo cp deploy/retro-rally.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now retro-rally
# Check the User= line — it must match the owner of /opt/retro-rally (usually ubuntu).

[Unit]
Description=RETRO RALLY (Node.js game server)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/retro-rally/src
Environment=PORT=8080
# only nginx faces outward: Node listens on the loopback interface
Environment=HOST=127.0.0.1
Environment=NODE_ENV=production
# Your own admin key (unset, the server creates src/data/admin-key.txt):
# Environment=ADMIN_KEY=your-own-key
ExecStart=/usr/bin/node /opt/retro-rally/src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
